{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--require ./utils/telemetry/Instrumentation.js' next dev",
    "build": "next build",
    "start": "node --require ./Instrumentation.js server.js",
    "lint": "next lint",
    "cy:open": "cypress open",
    "grpc:generate": "mkdir -p ./protos && protoc -I ./pb  --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_opt=esModuleInterop=true --ts_proto_out=./protos --ts_proto_opt=outputServices=grpc-js demo.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@grpc/grpc-js": "1.14.5",
    "@openfeature/flagd-provider": "0.16.1",
    "@openfeature/flagd-web-provider": "0.7.4",
    "@openfeature/react-sdk": "1.4.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/auto-instrumentations-web": "0.67.0",
    "@opentelemetry/context-zone": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/opentelemetry-browser-detector": "0.222.0",
    "@opentelemetry/resource-detector-alibaba-cloud": "0.37.0",
    "@opentelemetry/resource-detector-aws": "2.22.0",
    "@opentelemetry/resource-detector-container": "0.8.13",
    "@opentelemetry/resource-detector-gcp": "0.57.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@tanstack/react-query": "5.103.1",
    "cookies-next": "6.1.1",
    "currency-symbol-map": "5.1.0",
    "dotenv": "18.0.0",
    "dotenv-expand": "1000.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "styled-components": "6.5.3",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/styled-components": "5.1.34",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "cypress": "14.5.3",
    "eslint": "9.32.0",
    "eslint-config-next": "15.4.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "openapi-typescript": "7.8.0",
    "ts-proto": "2.7.5",
    "typescript": "5.9.2"
  }
